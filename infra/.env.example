# You can switch mirror source by editing these image URLs.
# Default points to DaoCloud mirror.
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7
NATS_IMAGE=docker.m.daocloud.io/library/nats:2.10

# Nginx upstream sync (self-hosted dynamic backend scale)
NODE_KEY_PREFIX=ws:backend:node:
SYNC_INTERVAL_SECONDS=15
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH=/healthz
# Optional: for dockerized nginx on host
# NGINX_RELOAD_CMD=docker exec game-nginx-lb nginx -t && docker exec game-nginx-lb nginx -s reload
