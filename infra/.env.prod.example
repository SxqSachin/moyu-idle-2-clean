# ---------- Common images ----------
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7
NATS_IMAGE=docker.m.daocloud.io/library/nats:2.10
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27

# ---------- PostgreSQL node ----------
POSTGRES_USER=game
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=game
PG_MAX_CONNECTIONS=300
PG_BIND_IP=0.0.0.0
PG_PORT=5432
PG_DATA_DIR=/data/game/pg

# ---------- Redis node ----------
REDIS_PASSWORD=change-this-redis-password
REDIS_BIND_IP=0.0.0.0
REDIS_PORT=6379
REDIS_DATA_DIR=/data/game/redis

# ---------- NATS node ----------
NATS_NAME=game-nats-1
NATS_BIND_IP=0.0.0.0
NATS_PORT=4222
NATS_MONITOR_BIND_IP=0.0.0.0
NATS_MONITOR_PORT=8222
NATS_DATA_DIR=/data/game/nats

# ---------- Backend node ----------
APP_ENV=production
DATABASE_URL=postgres://game:change-this-strong-password@192.0.2.31:5432/game?sslmode=disable
REDIS_ADDR=192.0.2.32:6379
REDIS_DB=0
NATS_URL=nats://192.0.2.33:4222
MQ_TOPIC_PREFIX=game
# Keep off until all action-capable binaries support ordinary-statistical-v1.
ORDINARY_SETTLEMENT_ENABLED=false
WS_TARGETED_ROUTING_ENABLED=true
SCHEDULER_SHARDS=16
SCHEDULER_ENGINE=minheap
SCHEDULER_TICK_MS=100
SCHEDULER_WHEEL_SIZE=512
NODE_ADVERTISE_ADDR=203.0.113.21:8080
NODE_REGISTRY_PREFIX=ws:backend:node:
NODE_HEARTBEAT_SECONDS=30
NODE_HEARTBEAT_INTERVAL_SECONDS=10
JWT_SECRET=change-this-jwt-secret
WS_MESSAGE_KEY=
REAL_IP_PROXY_HEADER=X-Forwarded-For
REAL_IP_TRUSTED_PROXY_CHECK=true
REAL_IP_TRUSTED_PROXIES=198.51.100.10,198.51.100.11
REAL_IP_ENABLE_VALIDATION=true
SERVER_BIND_IP=0.0.0.0
SERVER_PORT=8080

# ---------- Battle worker ----------
BATTLE_WORKER_IMAGE=mysecondwebgame-battle-worker:latest

# ---------- Frontend node ----------
WEB_BIND_IP=0.0.0.0
WEB_PORT=80

# ---------- Nginx LB node ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NODE_KEY_PREFIX=ws:backend:node:
SYNC_INTERVAL_SECONDS=15
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH=/healthz
# Dockerized nginx reload example:
# NGINX_RELOAD_CMD=docker exec game-nginx-lb nginx -t && docker exec game-nginx-lb nginx -s reload
# If deployed outside repo, mount absolute paths
# NGINX_CONF_FILE=/opt/MySecondWebGame/infra/nginx/multi-tier-lb.conf
# NGINX_UPSTREAM_DIR=/opt/MySecondWebGame/infra/nginx/upstreams
# NGINX_CERT_DIR=/opt/MySecondWebGame/infra/nginx/certs
