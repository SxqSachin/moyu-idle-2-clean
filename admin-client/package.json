{
  "name": "mysecondwebgame-admin-client",
  "version": "0.1.0",
  "private": true,
  "main": "main/index.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n renderer,electron -c cyan,yellow \"npm run dev:renderer\" \"npm run dev:app\"",
    "dev:app": "wait-on http://127.0.0.1:5178 && ADMIN_RENDERER_DEV_URL=http://127.0.0.1:5178 electron .",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p renderer/tsconfig.json",
    "build": "npm run typecheck && npm run build:renderer",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.mysecondwebgame.adminclient",
    "productName": "MySecondWebGame Admin",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
