{
  "name": "mysecondwebgame-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app-style": "./src/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress-dist.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:combat-model": "playwright test -c playwright.combat-model.config.ts",
    "harness:pr": "npm run typecheck && npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-vue/game-icons": "^1.0.4",
    "@iconify/vue": "^5.0.1",
    "@tanstack/vue-query": "^5.100.8",
    "@tanstack/vue-virtual": "^3.13.30",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.16.0",
    "d3-hierarchy": "^3.1.2",
    "driver.js": "^1.4.0",
    "element-plus": "^2.7.8",
    "gsap": "^3.15.0",
    "pako": "^2.1.0",
    "pinia": "^2.1.7",
    "reconnecting-websocket": "^4.4.0",
    "vue": "^3.4.31",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.4.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.17",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^5.0.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.5.3",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.3.4",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.0.29"
  }
}
